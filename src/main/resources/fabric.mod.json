{
	"schemaVersion": 1,
	"id": "block-corner-copy-location",
	"version": "${version}",
	"name": "Block Corner Copy Location",
	"description": "Copy the nearest corner of the targeted block's rendered model without grid snapping, with eight small stationary redstone-dust particles marking the copied corner.",
	"authors": [
		"NickAcPT"
	],
	"contact": {
		"homepage": "https://nickac.dev/",
		"sources": "https://github.com/NickAcPT/block-corner-copy-location"
	},
	"license": "MIT",
	"icon": "assets/block-corner-copy-location/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			{
				"value": "io.github.nickacpt.blockcornercopylocation.BlockCornerCopyLocation",
				"adapter": "kotlin"
			}
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": ">=0.163.0",
		"fabric-language-kotlin": ">=1.14.2+kotlin.2.4.21"
	}
}